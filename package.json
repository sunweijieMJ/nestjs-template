{
  "name": "nestjs-boilerplate",
  "version": "1.2.0",
  "description": "",
  "author": "",
  "private": true,
  "packageManager": "pnpm@11.23.0",
  "license": "MIT",
  "scripts": {
    "typeorm": "env-cmd -- ts-node ./node_modules/typeorm/cli.js",
    "migration:generate": "pnpm typeorm --dataSource=src/infrastructure/database/data-source.ts migration:generate",
    "postmigration:generate": "eslint src --fix && prettier src --write --log-level warn",
    "migration:create": "pnpm typeorm migration:create",
    "migration:run": "pnpm typeorm --dataSource=src/infrastructure/database/data-source.ts migration:run",
    "migration:run:prod": "node ./node_modules/typeorm/cli.js --dataSource=dist/infrastructure/database/data-source.js migration:run",
    "migration:check": "pnpm typeorm --dataSource=src/infrastructure/database/data-source.ts migration:generate src/infrastructure/database/migrations/Check --check",
    "migration:revert": "pnpm typeorm --dataSource=src/infrastructure/database/data-source.ts migration:revert",
    "schema:drop": "pnpm typeorm --dataSource=src/infrastructure/database/data-source.ts schema:drop",
    "seed:create:relational": "hygen seeds create-relational",
    "generate:resource:relational": "hygen generate relational-resource",
    "postgenerate:resource:relational": "eslint src --fix && prettier src --write --log-level warn",
    "add:property:to-relational": "hygen property add-to-relational",
    "postadd:property:to-relational": "eslint src --fix && prettier src --write --log-level warn",
    "seed:run:relational": "ts-node ./src/infrastructure/database/seeds/relational/run-seed.ts",
    "seed:run:prod": "node ./dist/infrastructure/database/seeds/relational/run-seed.js",
    "prebuild": "rimraf dist",
    "build": "nest build",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:swc": "nest start -b swc -w",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "lint:check": "eslint . && prettier . --check && markdownlint-cli2",
    "lint:md": "markdownlint-cli2",
    "type-check": "pnpm type-check:app && pnpm type-check:test && pnpm type-check:node",
    "type-check:app": "tsc --noEmit -p tsconfig.json",
    "type-check:test": "tsc --noEmit -p tsconfig.test.json",
    "type-check:node": "tsc --noEmit -p tsconfig.node.json",
    "cspell": "cspell",
    "commit": "czg",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest",
    "test:cov": "vitest run --coverage",
    "test:debug": "vitest run --inspect-brk --no-file-parallelism",
    "test:e2e": "env-cmd -- vitest run --config vitest.e2e.config.mts",
    "prepare": "is-ci || husky",
    "release": "release-it"
  },
  "lint-staged": {
    "*.{ts,js,mjs,cjs}": [
      "eslint --fix --no-warn-ignored",
      "prettier --write"
    ],
    "!(*.ts|*.js|*.mjs|*.cjs)": [
      "prettier --write --ignore-unknown"
    ]
  },
  "config": {
    "commitizen": {
      "path": "node_modules/cz-git"
    }
  },
  "dependencies": {
    "@alicloud/dysmsapi20170525": "4.6.0",
    "@alicloud/openapi-client": "0.4.15",
    "@aws-sdk/client-s3": "3.1150.0",
    "@aws-sdk/s3-request-presigner": "3.1150.0",
    "@keyv/redis": "5.1.5",
    "@nestjs/bullmq": "12.0.0",
    "@nestjs/cache-manager": "12.0.1",
    "@nestjs/common": "12.1.3",
    "@nestjs/config": "12.0.1",
    "@nestjs/core": "12.1.3",
    "@nestjs/jwt": "12.0.3",
    "@nestjs/passport": "12.0.0",
    "@nestjs/platform-express": "12.1.3",
    "@nestjs/schedule": "12.0.2",
    "@nestjs/swagger": "12.0.2",
    "@nestjs/terminus": "12.1.0",
    "@nestjs/throttler": "6.7.1",
    "@nestjs/typeorm": "12.0.2",
    "@prometheus-io/client": "0.16.1",
    "@willsoto/nestjs-prometheus": "7.0.0",
    "bcryptjs": "3.0.3",
    "bullmq": "5.65.1",
    "cache-manager": "7.2.9",
    "class-transformer": "0.5.1",
    "class-validator": "0.15.1",
    "dotenv": "17.2.2",
    "handlebars": "4.7.10",
    "helmet": "8.3.0",
    "ioredis": "5.8.2",
    "keyv": "5.5.5",
    "ms": "2.1.3",
    "multer": "2.4.0",
    "multer-s3": "3.0.1",
    "nestjs-i18n": "10.8.5",
    "nestjs-pino": "5.3.1",
    "nodemailer": "7.0.7",
    "passport": "0.7.0",
    "passport-jwt": "4.0.1",
    "pg": "8.23.1",
    "pino": "10.4.0",
    "pino-http": "11.0.0",
    "pino-pretty": "13.2.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "swagger-ui-express": "5.0.1",
    "typeorm": "0.3.27"
  },
  "devDependencies": {
    "@commitlint/cli": "21.2.3",
    "@commitlint/config-conventional": "21.2.3",
    "@commitlint/format": "21.2.3",
    "@commitlint/types": "21.2.3",
    "@nestjs/cli": "12.0.8",
    "@nestjs/schematics": "12.0.7",
    "@nestjs/testing": "12.1.3",
    "@release-it/conventional-changelog": "12.0.2",
    "@swc/cli": "0.8.1",
    "@swc/core": "1.16.18",
    "@types/bcryptjs": "3.0.0",
    "@types/express": "5.0.6",
    "@types/ms": "2.1.0",
    "@types/multer": "2.3.0",
    "@types/multer-s3": "3.0.3",
    "@types/node": "22.20.5",
    "@types/nodemailer": "7.0.4",
    "@types/passport-jwt": "4.0.1",
    "@types/supertest": "6.0.3",
    "@vitest/coverage-v8": "5.0.4",
    "chalk": "6.0.1",
    "conventional-changelog-conventionalcommits": "10.4.1",
    "cspell": "10.3.6",
    "cz-git": "1.14.0",
    "czg": "1.14.0",
    "env-cmd": "11.0.0",
    "eslint": "10.12.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-check-file": "3.3.2",
    "globals": "17.13.0",
    "husky": "9.1.7",
    "hygen": "6.2.11",
    "is-ci": "4.1.0",
    "lint-staged": "17.6.0",
    "markdownlint-cli2": "0.23.3",
    "prettier": "3.9.10",
    "release-it": "21.1.1",
    "rimraf": "6.1.3",
    "supertest": "7.3.1",
    "ts-node": "10.9.2",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.2",
    "unplugin-swc": "2.0.0",
    "vite": "8.3.4",
    "vitest": "5.0.4"
  },
  "engines": {
    "node": ">=22.21.1",
    "pnpm": ">=11"
  },
  "release-it": {
    "git": {
      "commitMessage": "chore: release v${version}"
    },
    "github": {
      "release": true
    },
    "npm": {
      "publish": false
    },
    "plugins": {
      "@release-it/conventional-changelog": {
        "infile": "CHANGELOG.md",
        "preset": {
          "name": "conventionalcommits",
          "types": [
            {
              "type": "chore",
              "scope": "deps",
              "section": "Dependency Upgrades"
            },
            {
              "type": "fix",
              "scope": "deps",
              "section": "Dependency Upgrades"
            },
            {
              "type": "feat",
              "section": "Features"
            },
            {
              "type": "fix",
              "section": "Bug Fixes"
            },
            {
              "type": "perf",
              "section": "Performance Improvements"
            },
            {
              "type": "revert",
              "section": "Reverts"
            },
            {
              "type": "docs",
              "section": "Documentation"
            },
            {
              "type": "refactor",
              "section": "Code Refactoring"
            },
            {
              "type": "test",
              "section": "Tests"
            },
            {
              "type": "ci",
              "section": "Continuous Integration"
            }
          ]
        }
      }
    }
  }
}
