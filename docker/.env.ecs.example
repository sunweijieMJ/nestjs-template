# ECS 服务器环境变量示例（配合 docker/docker-compose.ecs.yaml，GHCR 镜像模式）
# 复制此文件到部署目录并重命名为 .env
# cp docker/.env.ecs.example .env
#
# NODE_ENV、DATABASE_TYPE/HOST/PORT、REDIS_HOST/PORT 由 docker-compose.ecs.yaml 固定，此处的值不生效

# ========================================
# 应用基础配置
# ========================================
NODE_ENV=production
APP_PORT=3000
APP_NAME="NestJS API"
API_PREFIX=api
# 需与 src/i18n 下的目录名一致（zh 或 en）
APP_FALLBACK_LANGUAGE=zh
APP_HEADER_LANGUAGE=x-custom-lang
# 生产环境必填，允许跨域的前端域名，多个用逗号分隔；留空会放行任意来源
FRONTEND_DOMAIN=https://your-frontend-domain.com
BACKEND_DOMAIN=https://your-backend-domain.com

# ========================================
# 初始化配置
# ========================================
# 首次部署时设置为 true 以运行种子数据（省市区、角色、权限等），写入后改回 false
RUN_SEEDS=false
# 生产环境种子只在以下两项都设置时创建管理员账号（密码为明文，入库前做 md5 + bcrypt）
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=

# ========================================
# 日志配置
# ========================================
LOG_LEVEL=info
LOG_PRETTY_PRINT=false

# ========================================
# 数据库配置（PostgreSQL）
# ========================================
DATABASE_TYPE=postgres
DATABASE_HOST=postgres
DATABASE_PORT=5432
DATABASE_USERNAME=postgres
DATABASE_PASSWORD=your-secure-password-here
DATABASE_NAME=nestjs_api
DATABASE_SYNCHRONIZE=false
# 连接池上限，需小于 PostgreSQL 的 max_connections（默认 100）
DATABASE_MAX_CONNECTIONS=20
DATABASE_SSL_ENABLED=false
DATABASE_REJECT_UNAUTHORIZED=true
DATABASE_CA=
DATABASE_KEY=
DATABASE_CERT=
DATABASE_URL=

# ========================================
# JWT 认证配置
# ========================================
# 生产环境要求每个密钥至少 32 位且四个互不相同，可用 openssl rand -hex 32 分别生成
AUTH_JWT_SECRET=your-jwt-secret-here
AUTH_JWT_TOKEN_EXPIRES_IN=15m
AUTH_REFRESH_SECRET=your-refresh-secret-here
AUTH_REFRESH_TOKEN_EXPIRES_IN=7d
AUTH_FORGOT_SECRET=your-forgot-secret-here
AUTH_FORGOT_TOKEN_EXPIRES_IN=30m
AUTH_CONFIRM_EMAIL_SECRET=your-confirm-email-secret-here
AUTH_CONFIRM_EMAIL_TOKEN_EXPIRES_IN=1d

# ========================================
# Redis 配置
# ========================================
REDIS_ENABLED=true
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# ========================================
# 文件存储配置
# ========================================
FILE_DRIVER=local
ACCESS_KEY_ID=
SECRET_ACCESS_KEY=
AWS_S3_REGION=
AWS_DEFAULT_S3_BUCKET=
AWS_S3_ENDPOINT=
# 仅在设置 AWS_S3_ENDPOINT 时生效：MinIO 用 true，阿里云 OSS 用 false
AWS_S3_FORCE_PATH_STYLE=true

# ========================================
# 邮件配置
# ========================================
MAIL_HOST=smtp.example.com
MAIL_PORT=465
MAIL_USER=your-email@example.com
MAIL_PASSWORD=your-email-password
MAIL_IGNORE_TLS=false
MAIL_SECURE=true
MAIL_REQUIRE_TLS=true
MAIL_DEFAULT_EMAIL=noreply@example.com
MAIL_DEFAULT_NAME=NestJS API

# ========================================
# 限流配置
# ========================================
THROTTLE_ENABLED=true
THROTTLE_TTL=60
THROTTLE_LIMIT=100
# 应用前的反向代理层数（Nginx/SLB 等），限流按 X-Forwarded-For 识别客户端 IP
# 仅在 API 端口不对公网开放、只经代理访问时设置，否则客户端可伪造来源 IP
TRUST_PROXY=0

# ========================================
# 监控指标
# ========================================
METRICS_ENABLED=true
METRICS_PATH=metrics
# /metrics 与完整 /health 的 Bearer 令牌（至少 16 位）；生产环境未配置时两者都拒绝访问
METRICS_TOKEN=
# 生产环境默认关闭 Swagger，设为 true 开启
SWAGGER_ENABLED=false

# ========================================
# 阿里云短信服务配置
# ========================================
SMS_ACCESS_KEY_ID=your-sms-access-key-id
SMS_ACCESS_KEY_SECRET=your-sms-access-key-secret
SMS_SIGN_NAME=您的应用签名
SMS_TEMPLATE_CODE=SMS_123456789
SMS_CODE_EXPIRES=300
SMS_CODE_LENGTH=6
SMS_ENDPOINT=dysmsapi.aliyuncs.com
SMS_MOCK_MODE=false
SMS_MAX_ATTEMPTS=5
SMS_RESEND_INTERVAL=60

# ========================================
# 微信集成配置
# ========================================
WECHAT_MINI_APP_ID=your-mini-app-id
WECHAT_MINI_APP_SECRET=your-mini-app-secret
# 订阅消息跳转的小程序版本：developer | trial | formal
WECHAT_MINI_PROGRAM_STATE=formal
# 支付成功订阅消息模板，留空则不发送；字段映射格式 orderNo:character_string1,amount:amount2,paidAt:time3
WECHAT_SUBSCRIBE_ORDER_PAID_TEMPLATE_ID=
WECHAT_SUBSCRIBE_ORDER_PAID_FIELDS=
WECHAT_APP_ID=your-wechat-app-id
WECHAT_APP_SECRET=your-wechat-app-secret

# ========================================
# 微信支付配置
# ========================================
WECHAT_PAY_MCH_ID=your-mch-id
WECHAT_PAY_API_V3_KEY=your-api-v3-key
WECHAT_PAY_SERIAL_NO=your-serial-no
WECHAT_PAY_PRIVATE_KEY=your-private-key
WECHAT_PAY_NOTIFY_URL=https://your-backend-domain.com/api/v1/wechat/notify
# 微信支付公钥模式（新商户默认）填写以下两项；留空则自动下载平台证书
WECHAT_PAY_PUBLIC_KEY_ID=
WECHAT_PAY_PUBLIC_KEY=

# ========================================
# 支付宝支付配置
# ========================================
ALIPAY_APP_ID=your-alipay-app-id
# 应用私钥
ALIPAY_PRIVATE_KEY=your-alipay-private-key
# 支付宝公钥（开放平台中的支付宝公钥，不是应用公钥）
ALIPAY_PUBLIC_KEY=your-alipay-public-key
ALIPAY_GATEWAY=https://openapi.alipay.com/gateway.do
ALIPAY_SIGN_TYPE=RSA2
ALIPAY_CHARSET=utf-8
ALIPAY_NOTIFY_URL=https://your-backend-domain.com/api/v1/alipay/notify
ALIPAY_RETURN_URL=https://your-frontend-domain.com/payment/success
ALIPAY_SANDBOX=false
